# The rungar package's preinst. The rungar user is made before the package's
# files are unpacked, so that /etc/rungar is given its group as it is.

set -e

[ "$1" = install ] || [ "$1" = upgrade ] || exit 0

if ! getent group rungar >/dev/null; then
  groupadd --system rungar
fi
if ! getent passwd rungar >/dev/null; then
  useradd --system --gid rungar --no-create-home --home-dir / \
    --shell /usr/sbin/nologin --comment Rungar rungar
fi
