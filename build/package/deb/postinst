# The rungar package's postinst: configure, with the version replaced as $2
# on an upgrade. A first install enables and starts nothing, unlike most
# Debian services: rungar has nothing to do until it is configured, and no
# configuration is a useful default. An upgrade restarts the daemon if it
# runs, which disturbs no job, as the daemon that starts adopts every runner
# -- unless the new rungar would not start from the configuration, when the
# old one is left running.

set -e

[ "$1" = configure ] || exit 0

# Only where systemd runs, as it may not when building an image.
if [ -d /run/systemd/system ]; then
  systemctl daemon-reload
  if [ -z "$2" ]; then
    cat <<'MSG'

rungar is installed but not started: it has nothing to do until it is
configured. Write /etc/rungar/config.yaml -- https://rungar.sh/docs/reference/configuration/
describes every setting -- then check it and start the daemon:

  sudo -u rungar rungar validate
  sudo systemctl enable --now rungar

MSG
  elif systemctl is-active --quiet rungar.service; then
    if runuser -u rungar -- /usr/bin/rungar validate -f /etc/rungar/config.yaml >/dev/null 2>&1; then
      systemctl try-restart rungar.service ||
        echo "rungar did not restart: see journalctl -u rungar" >&2
    else
      echo "rungar: not restarted, as the new version does not load /etc/rungar/config.yaml;" >&2
      echo "  see sudo -u rungar rungar validate, then sudo systemctl restart rungar" >&2
    fi
  fi
fi
